{
  "name": "pi-model-filter",
  "version": "0.1.0",
  "type": "module",
  "description": "pi extension that rebuilds a provider's model list from a declared catalog and drops excluded models by id",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model",
    "filter"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZouZhao321/pi-model-filter.git"
  },
  "homepage": "https://github.com/ZouZhao321/pi-model-filter#readme",
  "bugs": {
    "url": "https://github.com/ZouZhao321/pi-model-filter/issues"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pack": "node scripts/check-pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run format:check && npm run check:pack"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
